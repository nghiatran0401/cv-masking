# cv-masking .gitignore
# Policy: no runtime document data, derived data, or logs may ever be committed.
# See docs/data-retention.md. The only re-included documents are synthetic
# fixtures whose filename starts with "synthetic-" inside a tests/fixtures/synthetic/ tree.

# ---------------------------------------------------------------------------
# Runtime data directories (should live outside the repo; ignored defensively)
# ---------------------------------------------------------------------------
data/
runtime/
uploads/
upload/
inputs/
input/
outputs/
output/
work/
tmp/
temp/
cache/
quarantine/
exports/
reports/
downloads/
.cv-masking/
CVMasking/

# ---------------------------------------------------------------------------
# Document and image types (CVs arrive as PDF/DOCX; any of these may hold PII)
# ---------------------------------------------------------------------------
*.pdf
*.PDF
*.doc
*.DOC
*.docx
*.DOCX
*.docm
*.dot
*.dotx
*.odt
*.rtf
*.pages
*.txt.orig
*.png
*.PNG
*.jpg
*.JPG
*.jpeg
*.JPEG
*.gif
*.bmp
*.tif
*.tiff
*.heic
*.HEIC
*.webp
*.zip
*.ZIP
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# ---------------------------------------------------------------------------
# Databases, reports, logs, dumps
# ---------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-journal
*.db-wal
*.db-shm
*.csv
*.CSV
*.xlsx
*.xls
*.log
logs/
*.dump
*.core
core.*
*.heapsnapshot
*.prof
*.trace

# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.token

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
build/
dist/

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
.vite/
coverage/
playwright-report/
test-results/
blob-report/
playwright/.cache/
*.tsbuildinfo
npm-debug.log*

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*~
.idea/

# ---------------------------------------------------------------------------
# Synthetic fixtures — the ONLY documents allowed in git.
# Must be generated or hand-authored synthetic content; see SECURITY.md.
# ---------------------------------------------------------------------------
!**/tests/fixtures/synthetic/
!**/tests/fixtures/synthetic/**/
!**/tests/fixtures/synthetic/**/synthetic-*
